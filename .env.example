# ============================================================
# XT-Bot 环境变量样例文件
#
# 使用方法：
#   1. 复制为 .env：  cp .env.example .env
#   2. 将下方占位值（your_xxx_here）替换为你的真实配置
#   3. 运行 ./run.sh init / sync 开始使用
#
# 注意：.env 已被 git 忽略，不会提交到仓库，密钥安全。
#       提供 PROXY_URL 可绕过网络限制访问 X / Telegram。
# ============================================================

# X（Twitter）认证 Token（必需，爬取推文用）
# 从浏览器登录 x.com 后的 Cookie 中获取 auth_token 填入
AUTH_TOKEN=your_auth_token_here

# X 的 CSRF Token ct0（可选，从浏览器 Cookie 获取；提供后可减少握手、降低风控触发）
CT0=your_ct0_here

# 你的 X 用户名（必需，用于抓取关注列表）
SCREEN_NAME=your_screen_name_here

# Telegram Bot Token（必需，推送用，@BotFather 创建）
BOT_TOKEN=your_bot_token_here

# Telegram 接收者 Chat ID（必需，@userinfobot 查询）
CHAT_ID=your_chat_id_here

# 飞书机器人 Webhook Key（可选，告警/动态通知）
LARK_KEY=your_lark_key_here

# Redis 配置 JSON（可选，用于远程覆盖 config/config.json）
# 留空则使用本地 config/config.json
REDIS_CONFIG=

# SOCKS5/HTTP 代理地址（可选，爬取 X 时使用；本机 V2Ray SOCKS5 端口）
# 留空则直连（可能因网络被墙而失败）
PROXY_URL=socks5://127.0.0.1:10808
